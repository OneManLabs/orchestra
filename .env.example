# Recovery/admin bearer token. Normal Agents should enroll for device credentials.
# Generate with: openssl rand -hex 32
FLEET_TOKEN=replace-with-at-least-32-random-bytes
# Key material for the AES-256-GCM vault and encrypted Core backups.
# Generate with: openssl rand -base64 32
FLEET_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# Core binding. Use 0.0.0.0 on the always-on Mac mini and restrict access with Tailscale ACLs.
FLEET_HOST=127.0.0.1
FLEET_PORT=4780
FLEET_CORE_URL=http://127.0.0.1:4780
# URL that enrolled Agents and QR codes can actually reach.
FLEET_PUBLIC_URL=http://127.0.0.1:4780

# Agent identity and optional human-readable labels.
# FLEET_DEVICE_ID=
# FLEET_DEVICE_NAME=
# FLEET_DEVICE_ROLE=workstation
# FLEET_PROJECT_ROOTS=/Users/example/Projects,/Volumes/NAS/Projects

# Persistence location for Fleet Core.
# FLEET_DATA_DIR=/path/to/fleet-data
# FLEET_BACKUP_INTERVAL_HOURS=24
# FLEET_BACKUP_RETENTION_COUNT=14
# Outbound HTTP blocks private/link-local targets by default. Prefer a narrow hostname allowlist.
# FLEET_HTTP_ALLOWED_HOSTS=hooks.example.com,minio.example.ts.net
# FLEET_HTTP_ALLOW_PRIVATE=false

# V2 enrollment and host-control switches.
# FLEET_ENROLLMENT_TOKEN=short-lived-token-returned-by-core
# FLEET_AGENT_DATA_DIR=/path/to/private-agent-state
# FLEET_CREDENTIAL_FILE=/path/to/device-credential.json
# FLEET_ALLOW_POWER_ACTIONS=false
# FLEET_REQUIRE_SIGNED_UPDATES=true
# FLEET_UPDATE_PUBLIC_KEY=base64-encoded-ed25519-public-key
# FLEET_PREVENT_SLEEP_DURING_JOBS=true

# Fleet MCP (stdio by default; set HTTP only for remote MCP clients).
# FLEET_MCP_TRANSPORT=stdio
# FLEET_MCP_READ_ONLY=true
# FLEET_MCP_TOKEN=separate-at-least-32-byte-http-mcp-token
# FLEET_MCP_ALLOWED_HOSTS=fleet-mcp.example.ts.net
# FLEET_MCP_ALLOWED_TOOLS=fleet_list_devices,fleet_get_device,fleet_get_health
