#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

echo "This joins the Pi to your tailnet and configures it as the home subnet router and exit node."
echo "Never share the login URL or device code that Tailscale displays."
tailscale up \
  --hostname=fleet-gateway \
  --operator=fleetadmin \
  --advertise-routes=192.168.4.0/22 \
  --advertise-exit-node \
  --accept-routes=false \
  --snat-subnet-routes=true \
  --stateful-filtering=true
tailscale set --auto-update=true
systemctl try-restart fleet-canvas-agent.service 2>/dev/null || true

echo "Tailscale is connected and automatic client updates are enabled."
echo "Approve subnet 192.168.4.0/22 and the exit-node role in the Tailscale admin console."
